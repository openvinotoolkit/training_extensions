{
    "name": "@geti/app-ui",
    "version": "3.4.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=v24.2.0",
        "npm": ">=11.14.0"
    },
    "scripts": {
        "build": "rsbuild build",
        "build:tauri": "rsbuild build --env-mode tauri",
        "build:api": "npx openapi-typescript ./src/api/openapi-spec.json -o ./src/api/openapi-spec.d.ts && prettier --write src/api/openapi-spec.d.ts",
        "build:api:download": "curl --fail --insecure -o ./src/api/openapi-spec.json https://localhost:7860/api/openapi.json && prettier --write src/api/openapi-spec.json",
        "update-spec": "npm run build:api:download && npm run build:api",
        "cyclic-deps-check": "npx madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
        "start": "rsbuild dev",
        "start:tauri": "rsbuild dev --env-mode tauri",
        "start:desktop": "tauri dev",
        "server": "cd ../backend && just run-server",
        "format": "prettier --write .",
        "format:check": "prettier --check --cache \"./src/**/*.{js,ts,jsx,tsx,css,scss,sass}\"",
        "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
        "lint:fix": "eslint --fix \"./src/**/*.ts*\"",
        "preview": "npm run build && rsbuild preview",
        "preview:tauri": "rsbuild preview --env-mode tauri --port 3001",
        "test:unit": "rstest --config rstest.config.ts",
        "test:unit:watch": "rstest --config rstest.config.ts --watch",
        "test:unit:coverage": "rstest --coverage",
        "test:component": "npx playwright test --project=component --project=\"Tauri component tests\"",
        "test:e2e": "npx playwright test --project=e2e",
        "type-check": "tsc --noEmit",
        "tauri": "tauri"
    },
    "dependencies": {
        "@geti-ui/smart-tools": "^1.7.0",
        "@geti-ui/ui": "^1.7.0",
        "@react-aria/utils": "^3.34.1",
        "@tanstack/react-query": "~5.104.1",
        "@tauri-apps/api": "2.12.0",
        "@tauri-apps/plugin-dialog": "2.7.2",
        "@tauri-apps/plugin-fs": "2.5.1",
        "@tauri-apps/plugin-opener": "2.6.0",
        "@use-gesture/react": "~10.3.1",
        "clsx": "~2.1.1",
        "comlink": "~4.4.2",
        "i18next": "~26.4.2",
        "i18next-browser-languagedetector": "~8.2.1",
        "lodash-es": "~4.18.1",
        "onnxruntime-web": "~1.30.0",
        "openapi-fetch": "~0.17.0",
        "openapi-react-query": "~0.5.4",
        "polylabel": "~2.1.0",
        "pretty-bytes": "^7.2.0",
        "react": "~19.3.0",
        "react-aria": "~3.51.0",
        "react-aria-components": "~1.20.0",
        "react-dom": "~19.3.0",
        "react-error-boundary": "~6.1.6",
        "react-hotkeys-hook": "^5.3.3",
        "react-i18next": "~17.0.15",
        "react-router": "~7.18.3",
        "react-stately": "~3.49.0",
        "recharts": "~3.10.1",
        "sonner": "2.0.7",
        "spin-delay": "^2.0.1",
        "tus-js-client": "~4.3.1",
        "usehooks-ts": "^3.1.1",
        "utif": "^3.1.0",
        "zipson": "^0.2.12"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "~3.3.7",
        "@eslint/js": "~9.39.5",
        "@ianvs/prettier-plugin-sort-imports": "~4.7.1",
        "@msw/playwright": "~0.6.7",
        "@msw/source": "~0.6.1",
        "@playwright/test": "~1.64.0",
        "@rsbuild/core": "~2.2.12",
        "@rsbuild/plugin-react": "~2.1.1",
        "@rsbuild/plugin-sass": "~2.0.1",
        "@rsbuild/plugin-svgr": "~2.0.5",
        "@rstest/adapter-rsbuild": "~0.12.3",
        "@rstest/core": "~0.12.3",
        "@rstest/coverage-v8": "~0.12.3",
        "@tauri-apps/cli": "~2.12.1",
        "@testing-library/jest-dom": "~6.6.4",
        "@testing-library/react": "~16.3.3",
        "@testing-library/user-event": "~14.6.7",
        "@types/lodash-es": "~4.17.12",
        "@types/node": "~26.6.4",
        "@types/react": "~19.3.0",
        "@types/react-dom": "~19.3.0",
        "@types/utif": "^3.0.6",
        "@typescript-eslint/eslint-plugin": "~8.71.1",
        "@typescript-eslint/parser": "~8.71.1",
        "@wessberg/pointer-events": "^1.0.9",
        "eslint": "~9.39.5",
        "eslint-import-resolver-typescript": "~4.4.5",
        "eslint-plugin-header": "~3.1.1",
        "eslint-plugin-import": "~2.32.0",
        "eslint-plugin-jsx-a11y": "~6.10.2",
        "eslint-plugin-playwright": "~2.12.1",
        "eslint-plugin-react": "~7.37.5",
        "eslint-plugin-react-hooks": "~6.1.1",
        "globals": "~17.13.0",
        "jsdom": "~26.1.0",
        "msw": "~2.12.14",
        "node-fetch": "~3.3.2",
        "openapi-msw": "~1.2.0",
        "openapi-typescript": "~7.13.0",
        "prettier": "~3.9.9",
        "typescript": "~5.9.3",
        "typescript-eslint": "~8.71.1"
    },
    "overrides": {
        "@faker-js/faker": "~10.6.0"
    }
}
