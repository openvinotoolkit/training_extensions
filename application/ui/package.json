{
    "name": "@geti/app-ui",
    "version": "3.2.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=v24.2.0",
        "npm": ">=11.14.0"
    },
    "scripts": {
        "build": "rsbuild build",
        "build:tauri": "cross-env BUILD_TARGET=tauri rsbuild build",
        "build:api": "npx openapi-typescript ./src/api/openapi-spec.json -o ./src/api/openapi-spec.d.ts && prettier --write src/api/openapi-spec.d.ts",
        "build:api:download": "curl --fail --insecure -o ./src/api/openapi-spec.json https://localhost:7860/api/openapi.json && prettier --write src/api/openapi-spec.json",
        "update-spec": "npm run build:api:download && npm run build:api",
        "cyclic-deps-check": "npx madge --circular src/**/*.ts*",
        "start": "rsbuild dev",
        "start:tauri": "cross-env BUILD_TARGET=tauri rsbuild dev",
        "start:desktop": "tauri dev",
        "server": "cd ../backend && just run-server",
        "format": "prettier --write .",
        "format:check": "prettier --check --cache \"./src/**/*.{js,ts,jsx,tsx,css,scss,sass}\"",
        "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
        "lint:fix": "eslint --fix \"./src/**/*.ts*\"",
        "preview": "npm run build && rsbuild preview",
        "preview:tauri": "cross-env BUILD_TARGET=tauri rsbuild preview --port 3001",
        "test:unit": "vitest --config vitest.config.ts",
        "test:unit:watch": "vitest --config vitest.config.ts --reporter=tree --watch",
        "test:unit:coverage": "vitest --coverage",
        "test:component": "npx playwright test --project=component --project=\"Tauri component tests\"",
        "test:e2e": "npx playwright test --project=e2e",
        "type-check": "tsc --noEmit",
        "tauri": "tauri"
    },
    "dependencies": {
        "@geti-ui/smart-tools": "^1.6.0",
        "@geti-ui/ui": "^1.6.0",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/overlays": "^3.7.1",
        "@tanstack/react-query": "~5.101.4",
        "@tauri-apps/api": "~2.11.1",
        "@tauri-apps/plugin-dialog": "2.7.2",
        "@tauri-apps/plugin-fs": "2.5.1",
        "@tauri-apps/plugin-opener": "~2.5.4",
        "@use-gesture/react": "~10.3.1",
        "clsx": "~2.1.1",
        "comlink": "~4.4.2",
        "dayjs": "^1.11.21",
        "i18next": "~26.3.6",
        "i18next-browser-languagedetector": "~8.2.1",
        "lodash-es": "~4.18.1",
        "onnxruntime-web": "~1.27.0",
        "openapi-fetch": "~0.17.0",
        "openapi-react-query": "~0.5.4",
        "polylabel": "~2.1.0",
        "pretty-bytes": "^7.1.1",
        "react": "~19.1.1",
        "react-aria": "^3.49.0",
        "react-aria-components": "^1.11.0",
        "react-cool-virtual": "^0.7.0",
        "react-dom": "~19.1.1",
        "react-error-boundary": "~3.1.4",
        "react-hotkeys-hook": "^5.3.3",
        "react-i18next": "~17.0.11",
        "react-router-dom": "~6.30.4",
        "react-stately": "^3.47.0",
        "recharts": "~3.10.1",
        "sonner": "^2.0.7",
        "spin-delay": "^2.0.1",
        "static-path": "~0.0.4",
        "usehooks-ts": "^3.1.1",
        "utif": "^3.1.0",
        "uuid": "~14.0.1",
        "zipson": "^0.2.12"
    },
    "devDependencies": {
        "@eslint/compat": "~1.2.8",
        "@eslint/eslintrc": "~3.3.6",
        "@eslint/js": "~9.39.2",
        "@ianvs/prettier-plugin-sort-imports": "~4.7.1",
        "@msw/playwright": "~0.6.7",
        "@msw/source": "~0.6.1",
        "@playwright/test": "~1.61.1",
        "@rsbuild/core": "~2.1.10",
        "@rsbuild/plugin-babel": "~2.0.1",
        "@rsbuild/plugin-react": "~2.1.0",
        "@rsbuild/plugin-sass": "~2.0.1",
        "@rsbuild/plugin-svgr": "~2.0.5",
        "@tauri-apps/cli": "~2.6.2",
        "@testing-library/jest-dom": "~6.6.4",
        "@testing-library/react": "~16.3.0",
        "@testing-library/user-event": "~14.6.1",
        "@types/lodash-es": "~4.17.12",
        "@types/node": "~26.1.2",
        "@types/react": "~19.1.10",
        "@types/react-dom": "~19.1.7",
        "@types/utif": "^3.0.6",
        "@typescript-eslint/eslint-plugin": "~8.65.0",
        "@typescript-eslint/parser": "~8.65.0",
        "@vitejs/plugin-react": "~6.0.5",
        "@vitest/coverage-v8": "~4.1.10",
        "@wessberg/pointer-events": "^1.0.9",
        "babel-plugin-react-compiler": "1.0.0",
        "cross-env": "~10.1.0",
        "eslint": "~9.39.2",
        "eslint-import-resolver-typescript": "~4.4.5",
        "eslint-plugin-header": "~3.1.1",
        "eslint-plugin-import": "~2.32.0",
        "eslint-plugin-jsx-a11y": "~6.10.2",
        "eslint-plugin-playwright": "~2.10.5",
        "eslint-plugin-react": "~7.37.5",
        "eslint-plugin-react-hooks": "~6.0.0-rc.2",
        "globals": "~14.0.0",
        "jsdom": "~26.1.0",
        "msw": "~2.12.10",
        "node-fetch": "~3.3.2",
        "openapi-msw": "~1.2.0",
        "openapi-typescript": "~7.13.0",
        "prettier": "~3.9.6",
        "typescript": "~5.9.3",
        "typescript-eslint": "~8.65.0",
        "vite-plugin-svgr": "~5.2.0",
        "vitest": "~4.1.10"
    }
}
