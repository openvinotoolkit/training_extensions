#!/usr/bin/env just --justfile

default:
    @just --list --unsorted

# -------------------------------------------------------------------------------------------------
# Virtual environment and dependency management
# -------------------------------------------------------------------------------------------------

uv_version := `grep -A 3 '\[tool\.uv\]' pyproject.toml | grep 'required-version' | sed 's/.*= "[~=<>]*\(.*\)"/\1/'`

_ensure_uv:
    @if ! command -v uv > /dev/null; then \
        curl --proto '=https' --tlsv1.2 -LsSf "https://github.com/astral-sh/uv/releases/download/{{uv_version}}/uv-installer.sh" | sh; \
    fi

# Create a virtual environment and install dependencies
[arg("device", short="d", long="device")]
venv device="cpu": _ensure_uv
    uv lock --check
    uv sync --frozen --extra {{ device }} --extra ultralytics

# Create a virtual environment including benchmark-dataset dependencies (e.g. kagglehub).
# Use this when running or testing the benchmark dataset preparation scripts.
[arg("device", short="d", long="device")]
venv-benchmark device="cpu": _ensure_uv
    uv lock --check
    uv sync --frozen --extra {{ device }} --extra ultralytics --extra benchmark

# Generate or update the uv lock file
venv-lock: _ensure_uv
    uv lock

# Patch pyproject.toml to build torch/torchvision against CUDA 12.6 instead of 13.0 for the 'cuda' target,
# needed for legacy Nvidia GPUs (Volta, Maxwell, Pascal). See https://github.com/open-edge-platform/geti/issues/7163
patch-for-legacy-gpu-support: _ensure_uv
    uv run python -c "from pathlib import Path; p = Path('pyproject.toml'); p.write_text(p.read_text().replace('cu130', 'cu126'))"
    just venv-lock

# -------------------------------------------------------------------------------------------------
# Linting and formatting
# -------------------------------------------------------------------------------------------------

# Run linters (ruff + pyrefly)
lint: ruff pyrefly

# Run ruff for linting and format checking
ruff: _ensure_uv
    uv run ruff check --output-format=github
    uv run ruff format --check

# Run ruff to format the code and apply fixes
ruff-fix: _ensure_uv
    uv run ruff check --fix
    uv run ruff format

# Run pyrefly to detect potential type errors
pyrefly: _ensure_uv
    uv run pyrefly check --baseline=pyrefly-baseline.json

# -------------------------------------------------------------------------------------------------
# Testing
# -------------------------------------------------------------------------------------------------

# Run unit tests with pytest
test-unit *ARGS: _ensure_uv
    uv run pytest ./tests/unit -v {{ ARGS }}

# Run lightning backend
test-unit-lightning *ARGS: _ensure_uv
    uv run pytest ./tests/unit/backend/lightning -v {{ ARGS }}

# Run model-related unit tests with pytest
test-unit-models *ARGS: _ensure_uv
    uv run pytest ./tests/unit/backend/*/models -v {{ ARGS }}

# Run ultralytics backend
test-unit-ultralytics *ARGS: _ensure_uv
    uv run pytest ./tests/unit/backend/ultralytics -v {{ ARGS }}

# Run huggingface backend
test-unit-huggingface *ARGS: _ensure_uv
    uv run pytest ./tests/unit/backend/huggingface -v {{ ARGS }}

# Run openvino backend
test-unit-openvino *ARGS: _ensure_uv
    uv run pytest ./tests/unit/backend/openvino -v {{ ARGS }}

# Run integration tests with pytest
test-integration *ARGS: _ensure_uv
    uv run pytest ./tests/integration -v {{ ARGS }}
